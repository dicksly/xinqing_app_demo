# 心理健康与情绪疗愈 App - 环境变量配置
# 复制此文件为 .env 并根据需要修改配置

# ============================================
# 应用配置
# ============================================
APP_NAME=心情疗愈 App
DEBUG=True
HOST=0.0.0.0
PORT=8000

# ============================================
# 数据库配置
# ============================================
# 本地默认使用 SQLite 数据库文件路径
DATABASE_URL=sqlite:///./xinqing.db

# 阿里云 RDS MySQL（本地调试可使用公网地址；生产 ECS 上推荐使用内网地址）
# 注意：不要把真实用户名和密码提交到代码仓库
# DATABASE_URL=mysql+pymysql://user:password@rm-example.mysql.rds.aliyuncs.com:3306/xinqing_app?charset=utf8mb4

# ============================================
# JWT 配置
# ============================================
SECRET_KEY=your-secret-key-change-in-production-please-use-strong-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=604800
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-this-admin-password
ENABLE_DEMO_PASSWORD_RESET=False

# ============================================
# 加密密钥
# ============================================
# 用于加密敏感数据，请使用强随机字符串
ENCRYPTION_KEY=your-encryption-key-change-in-production-please-use-strong-random-string

# ============================================
# AI 服务配置 (可选)
# ============================================
# 如果使用外部 AI 服务，配置以下参数
AI_API_KEY=sk-ylqzujkemdwkmapwscvqtjaazqrtcqyxpoehgeigogcfzybf
AI_API_BASE=https://api.siliconflow.cn/v1
AI_MODEL=Pro/deepseek-ai/DeepSeek-V3.2

# ============================================
# 文件上传配置
# ============================================
# 最大上传大小（字节），默认 10MB
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/ogg

# ============================================
# 分页配置
# ============================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================
# CORS 配置
# ============================================
# 允许的跨域来源，生产环境请设置具体域名
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# 前端配置
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
